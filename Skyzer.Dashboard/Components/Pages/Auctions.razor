@page "/auctions"
@using Skyzer.Dashboard.Services
@using Skyzer.Shared.Models
@using Skyzer.Shared
@rendermode InteractiveServer
@inject AuctionService AuctionService

<PageTitle>Auctions</PageTitle>

<h1>Auctions</h1>

@if (auctions is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Item Name</th>
                <th>Last Updated</th>
                <th>Price</th>
                <th>Live?</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in auctions)
            {
                <tr>
                    <td>
                        @if (a.ItemName != null)
                        {
                            @a.ItemName
                        }
                        else
                        {
                            @a.Extra
                        }
                    </td>
                    <td>
                        @PrettifyLastUpdatedUTC(a.LastUpdated) ago
                    </td>
                    <td>
                        @a.StartingBid.ToString("C")
                    </td>
                    <td>
                        @IsAuctionLive(a)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Auction>? auctions;

    protected override async Task OnInitializedAsync()
    {
        auctions = await AuctionService.GetAllAsync();
    }

    private string PrettifyLastUpdatedUTC(long lastUpdatedUTC)
    {
        DateTime lastUpdatedDateTime = TimeHelper.UnixEpochToUTCDateTime(lastUpdatedUTC);
        TimeSpan diff = lastUpdatedDateTime - DateTime.UtcNow;
        return TimeHelper.ToPrettyFormat(-diff);
    }

    private bool IsAuctionLive(Auction auction)
    {
        return !auction.Claimed && (@TimeHelper.UnixEpochToUTCDateTime(auction.End) - @DateTime.UtcNow > TimeSpan.Zero);
    }
}